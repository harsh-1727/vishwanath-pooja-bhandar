# ────────────────────────────────────────────────────────────────
# Environment variables — copy to .env.local and fill in.
# Never commit .env.local (already in .gitignore).
#
# Every variable here is OPTIONAL at build time. The site must build
# and run correctly with this file completely empty — components read
# these through config/ files with safe fallbacks (see MapEmbed,
# ContactForm). This keeps early deploys unblocked while real
# credentials are pending from the owner.
# ────────────────────────────────────────────────────────────────

# Public site URL — used for canonical URLs, sitemap.xml, JSON-LD, OG tags.
NEXT_PUBLIC_SITE_URL=https://vishwanathpoojabhandar.com

# Google Maps embed — NOT YET PROVIDED (see OWNER_GUIDE.md).
# Leave blank: MapEmbed renders an address + "Get Directions" link
# fallback instead of a broken iframe when this is empty.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# Contact form delivery — pick ONE approach when ready:
# Option A: transactional email (e.g. Resend)
RESEND_API_KEY=
CONTACT_FORM_TO_EMAIL=

# Analytics — privacy-respecting, no third-party ad tracking
# (see PROJECT_MASTER.md §15 Security Strategy). Leave blank to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Future: rate limiting for /api/contact (see middleware.ts TODO)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
